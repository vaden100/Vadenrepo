{
  "expo": {
    "name": "RUN ME MY MONEY",
    "slug": "run-me-my-money",
    "scheme": "rmmm",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111111",
    "ios": {
      "bundleIdentifier": "com.vadenworld.runmemymoney",
      "supportsTablet": false
    },
    "android": {
      "package": "com.vadenworld.runmemymoney"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick screenshots and photos to add as receipts to your report.",
          "cameraPermission": "Take a photo of a receipt or flyer for your report."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record a 60-second voice note for your report."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
