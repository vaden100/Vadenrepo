# Copy to .env.local (web) / .env (worker). Never commit real values.
# SPEC.md section 18.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server and worker ONLY. Never expose to the browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Mux video
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Email: Postmark or Resend
POSTMARK_TOKEN=
RESEND_API_KEY=

# Expo / EAS
EXPO_ACCESS_TOKEN=

# Evidence storage (web + worker). Default: Supabase Storage when the service key is set.
# STORAGE_DRIVER=local keeps files in STORAGE_LOCAL_DIR (development and E2E only; refused in
# production unless ALLOW_LOCAL_STORAGE=1 on a single server with a persistent disk).
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
ALLOW_LOCAL_STORAGE=
# Signs local upload URLs (32+ characters). Required when STORAGE_DRIVER=local in production.
UPLOAD_SIGNING_SECRET=

# Media pipeline (apps/worker)
# clamd for virus scans (INSTREAM). Unset = files are marked "unscanned" for moderators.
CLAMAV_HOST=
CLAMAV_PORT=3310
# OCR on images (tesseract.js). 1 = on. TESSDATA_PREFIX points at local language data.
OCR_ENABLED=
TESSDATA_PREFIX=
# Voice-note transcription, OpenAI-compatible /audio/transcriptions endpoint. Off when unset.
# Add the provider to /legal/subprocessors before turning it on.
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
POLL_MS=3000
VISION_API_KEY=

# Rate limiting
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Observability
SENTRY_DSN=
ANALYTICS_KEY=

# Security proxy (apps/web/proxy.ts)
# Header carrying the real client IP. Vercel sets x-forwarded-for; behind Cloudflare use cf-connecting-ip.
CLIENT_IP_HEADER=x-forwarded-for
# Per-instance cache for ban lookups (ms). Bans apply across instances within this window.
BAN_CACHE_TTL_MS=5000
# Optional: only these IPs / IPv4 ranges may open /admin and /api/admin (comma-separated).
ADMIN_IP_ALLOWLIST=

# Website (apps/web)
# Canonical origin for links, sitemap and social cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com
# Set to false on previews and staging so search engines do not index them.
NEXT_PUBLIC_ALLOW_INDEXING=true
# Analytics (optional). Both set = analytics available, still only after the visitor opts in.
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
